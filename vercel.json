{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/**,templates/**,v3/*.html,v3/*.js,v3/*.mjs,v3/*.json,v3/journal/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|mjs)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|avif|svg|woff|woff2|ttf|eot|ico)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/article.html", "has": [{ "type": "query", "key": "slug", "value": "(?<slug>[^&]+)" }], "destination": "/journal/:slug.html", "permanent": true },
    { "source": "/nos-produits/:path*", "destination": "/produits.html", "permanent": true },
    { "source": "/passez-commande/:path*", "destination": "/produits.html", "permanent": true },
    { "source": "/vitra-home-stories-for-winter", "destination": "/collections/vitra-home-stories-for-winter", "permanent": true },
    { "source": "/vitra-home-stories-for-winter/", "destination": "/collections/vitra-home-stories-for-winter", "permanent": true },
    { "source": "/nos-marques/vitra", "destination": "/collections/vitra", "permanent": true },
    { "source": "/nos-marques/vitra/", "destination": "/collections/vitra", "permanent": true },
    { "source": "/nos-marques/ichendorf", "destination": "/collections/ichendorf-milano", "permanent": true },
    { "source": "/nos-marques/ichendorf/", "destination": "/collections/ichendorf-milano", "permanent": true },
    { "source": "/nos-marques/polspotten", "destination": "/collections/pols-potten", "permanent": true },
    { "source": "/nos-marques/polspotten/", "destination": "/collections/pols-potten", "permanent": true },
    { "source": "/nos-marques/string-furniture", "destination": "/collections/string-furniture", "permanent": true },
    { "source": "/nos-marques/string-furniture/", "destination": "/collections/string-furniture", "permanent": true },
    { "source": "/nos-marques/:path*", "destination": "/marques.html", "permanent": true },
    { "source": "/prendre-rendez-vous/:path*", "destination": "/rendez-vous.html", "permanent": true },
    { "source": "/contact", "destination": "/contact.html", "permanent": true },
    { "source": "/v3/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/collections", "destination": "/marques.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
