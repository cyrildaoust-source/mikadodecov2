# Variables d'environnement du site — Mikado Deco
# Copier en .env pour le développement local. En production, elles vivent dans Vercel
# (Settings → Environment Variables) ; ne jamais versionner les vraies valeurs.
# Liste à jour au 21 octobre 2026 : chaque variable ci-dessous est lue par le code.

# ─── SHOPIFY STOREFRONT (catalogue, fiches, panier) ─────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
# Facultatif (défaut : 2024-10, lib/shopify/client.js).
SHOPIFY_API_VERSION=2024-10
# Domaine du paiement Shopify (ex. shop.mikadodeco.be) ; vide = l'hôte renvoyé par Shopify.
SHOPIFY_CHECKOUT_DOMAIN=

# ─── SHOPIFY ADMIN (inscription newsletter, ADR 0017) ───────────
# Application du Dev Dashboard limitée aux clients. Deux modes : identifiants (échangés
# contre un jeton de 24 h) ou jeton fixe. Sans eux, l'inscription part par e-mail.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_ADMIN_DOMAIN=your-store.myshopify.com

# ─── CACHE ET WEBHOOKS ──────────────────────────────────────────
# Webhook Shopify Products/update et Collections/update → POST /api/revalidate (HMAC),
# ou appel manuel avec Authorization: Bearer <REVALIDATE_TOKEN>.
SHOPIFY_WEBHOOK_SECRET=
REVALIDATE_TOKEN=

# ─── INDEX DU CATALOGUE (ADR 0002) ─────────────────────────────
# Fourni par Vercel quand le store Blob est branché ; sans lui, le site construit l'index lui-même.
BLOB_READ_WRITE_TOKEN=
# Jeton attendu par POST /api/cron/catalog-index (workflow warm-cache, toutes les 30 min).
CATALOG_INDEX_SECRET=
# Facultatif : adresse d'un index déjà construit (tests, Preview).
CATALOG_INDEX_URL=

# ─── E-MAILS (formulaires contact et rendez-vous, repli newsletter) ─
RESEND_API_KEY=
# Facultatifs (défauts : shop@mikadodeco.be et no-reply@mikadodeco.be).
CONTACT_TO=
CONTACT_FROM=
# Facultatifs : webhooks qui reçoivent aussi les envois.
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# ─── SERVEUR LOCAL ──────────────────────────────────────────────
PORT=4000
BASE_URL=http://localhost:4000

# ─── OUTILS (jamais en production) ──────────────────────────────
# Horloge imposée (date ISO) pour tester une saison : MIKADO_CLOCK=2026-12-01T10:00:00+01:00
MIKADO_CLOCK=
# 1 = montrer aussi les bandeaux de marque candidats (revue visuelle).
BRAND_HERO_REVIEW=
# 1 = simuler le lot d'enrichissement de recherche (data/catalog-enrichment/).
CATALOG_ENRICHMENT_PREVIEW=
# 0 = servir les sources JS/CSS non hachées (tests).
ASSETS_HASHED=
